@page "/account/access-denied"
@layout PublicLayout

<PageTitle>Access Denied | BloodLink</PageTitle>

<main class="bl-access-page">
    <section class="bl-access-card" aria-labelledby="access-denied-title">
        <span class="bl-access-icon"><AppIcon Name="shield" Size="28" /></span>
        <h1 id="access-denied-title">Access denied</h1>
        <p>You don't have permission to view this page. Please sign in with an authorised facility account or contact your administrator.</p>
        <a class="bl-btn bl-btn-primary" href="/account/login">Return to Login</a>
        <a class="bl-access-home" href="/">Back to BloodLink home</a>
    </section>
</main>
