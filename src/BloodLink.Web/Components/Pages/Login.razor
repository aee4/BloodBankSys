@page "/account/login"
@layout PublicLayout

<PageTitle>Facility Login | BloodLink</PageTitle>

<main class="bl-auth-page">
    <AuthAside />
    <section class="bl-auth-content" aria-labelledby="login-title">
        <div class="bl-auth-panel">
            <div class="bl-auth-mobile-brand"><BloodLinkBrand /></div>
            <div class="bl-auth-heading">
                <h1 id="login-title">Welcome back</h1>
                <p>Sign in to your facility's BloodLink account.</p>
            </div>

            <form method="post" action="/account/login" class="bl-auth-form" data-enhance="false">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                <div class="bl-field">
                    <label class="bl-label" for="login-email">Email address</label>
                    <input id="login-email" name="Email" class="bl-input" type="email" maxlength="256" autocomplete="username" placeholder="you@facility.com" required aria-required="true" />
                </div>
                <div class="bl-field">
                    <div class="bl-label-row">
                        <label class="bl-label" for="login-password">Password</label>
                        <a href="/account/forgot-password">Forgot password?</a>
                    </div>
                    <div class="bl-password-field">
                        <input id="login-password" name="Password" class="bl-input" type="password" maxlength="256" autocomplete="current-password" placeholder="Enter your password" required aria-required="true" />
                    </div>
                </div>
                <label class="bl-checkbox-row"><input type="checkbox" name="RememberMe" value="true" /> <span>Remember me on this device</span></label>
                @if (Status == "invalid") { <AlertMessage Variant="danger">Unable to sign in with these credentials.</AlertMessage> }
                @if (Status == "password-reset") { <AlertMessage>Password reset. Sign in with your new password.</AlertMessage> }
                @if (Status == "signed-out") { <AlertMessage>You have signed out.</AlertMessage> }
                <button class="bl-btn bl-btn-danger bl-btn-block" type="submit">Log In <AppIcon Name="arrow-right" Size="16" /></button>
            </form>

            <div class="bl-security-note"><AppIcon Name="shield" Size="13" /><span>Your connection is secure and encrypted.</span></div>
            <a class="bl-auth-home-link" href="/"><AppIcon Name="arrow-left" Size="14" /> Back to BloodLink home</a>
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
}
