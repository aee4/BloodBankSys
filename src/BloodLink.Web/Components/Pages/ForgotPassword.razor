@page "/account/forgot-password"
@layout PublicLayout
@rendermode InteractiveServer

<PageTitle>Forgot Password | BloodLink</PageTitle>

<main class="bl-auth-page">
    <AuthAside />
    <section class="bl-auth-content" aria-labelledby="forgot-title">
        <div class="bl-auth-panel">
            <div class="bl-auth-mobile-brand"><BloodLinkBrand /></div>
            <a class="bl-auth-back" href="/account/login"><AppIcon Name="arrow-left" Size="14" /> Back to login</a>
            <div class="bl-auth-symbol"><AppIcon Name="mail" Size="23" /></div>
            <div class="bl-auth-heading">
                <h1 id="forgot-title">Forgot your password?</h1>
                <p>Enter your account email and we'll send you instructions to reset your password.</p>
            </div>
            <EditForm Model="_model" OnValidSubmit="HandleRequest" FormName="forgot-password" class="bl-auth-form" novalidate>
                <DataAnnotationsValidator />
                <div class="bl-field">
                    <label class="bl-label" for="reset-email">Email address</label>
                    <InputText id="reset-email" class="bl-input" type="email" @bind-Value="_model.Email" autocomplete="email" placeholder="you@facility.com" required aria-required="true" />
                    <ValidationMessage For="() => _model.Email" />
                </div>
                @if (_serviceError is not null) { <AlertMessage Variant="danger"><span>@_serviceError</span></AlertMessage> }
                <button class="bl-btn bl-btn-danger bl-btn-block" type="submit">Send Reset Instructions <AppIcon Name="arrow-right" Size="16" /></button>
            </EditForm>
            <div class="bl-security-note"><AppIcon Name="shield" Size="13" /><span>For security, reset links expire after a short time.</span></div>
            <a class="bl-auth-home-link" href="/"><AppIcon Name="arrow-left" Size="14" /> Back to BloodLink home</a>
        </div>
    </section>
</main>

@code {
    private readonly ForgotPasswordFormModel _model = new();
    private string? _serviceError;
    private void HandleRequest() => _serviceError = "Password recovery is not connected yet. No reset email was sent.";
}
