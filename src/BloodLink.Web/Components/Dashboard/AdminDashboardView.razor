@inject IDashboardService Dashboard
@if (_loading)
{
    <LoadingState Message="Loading facility dashboard..." />
}
else if (_error is not null)
{
    <AlertMessage Variant="danger" Title="Could not load dashboard"><span>@_error</span></AlertMessage>
}
else if (_snapshot is not null)
{
    <div class="bl-dash-header"><div><h1 class="bl-dash-title">Facility dashboard</h1><p class="bl-dash-subtitle">Operational snapshot for your facility</p></div></div>
    <div class="bl-stat-grid bl-stat-grid-4">
        <StatCard Label="Total inventory" Value="@_snapshot.TotalInventoryUnits.ToString()" Icon="package" Sub="Across blood types" />
        <StatCard Label="Available inventory" Value="@_snapshot.AvailableInventoryUnits.ToString()" Icon="droplet" Sub="Across blood types" />
        <StatCard Label="Low-stock types" Value="@_snapshot.LowStockItems.ToString()" Icon="alert-triangle" Accent="@(_snapshot.LowStockItems > 0)" />
        <StatCard Label="Open needs" Value="@_snapshot.OpenNeeds.ToString()" Icon="clipboard-list" Sub="Pending review or searching" />
    </div>
    <div class="bl-stat-grid bl-stat-grid-3">
        <StatCard Label="Requests sent" Value="@_snapshot.SentRequests.ToString()" Icon="send" />
        <StatCard Label="Requests received" Value="@_snapshot.ReceivedRequests.ToString()" Icon="inbox" />
        <StatCard Label="Unread notifications" Value="@_snapshot.UnreadNotifications.ToString()" Icon="bell" Sub="For your account" />
    </div>
    <nav class="bl-quick-grid" aria-label="Facility workflow links">
        <a class="bl-quick-action" href="/needs"><AppIcon Name="clipboard-list" Size="16" /><span>Review needs</span></a>
        <a class="bl-quick-action" href="/requests/sent"><AppIcon Name="send" Size="16" /><span>Sent requests</span></a>
        <a class="bl-quick-action" href="/requests/received"><AppIcon Name="inbox" Size="16" /><span>Received requests</span></a>
        <a class="bl-quick-action" href="/inventory"><AppIcon Name="package" Size="16" /><span>Inventory</span></a>
        <a class="bl-quick-action" href="/notifications"><AppIcon Name="bell" Size="16" /><span>Notifications</span></a>
    </nav>
    <div class="bl-card-grid bl-card-grid-2">
        <section class="bl-card"><div class="bl-card-head"><h2>Recent needs</h2><a class="bl-link" href="/needs">View queue <AppIcon Name="chevron-right" Size="12" /></a></div>
            @if (_snapshot.PendingNeeds.Count == 0) { <EmptyState Icon="clipboard-list" Title="No open needs" Description="New internal needs will appear here." /> }
            else
            {
                <div class="bl-list">@foreach (var need in _snapshot.PendingNeeds.OrderByDescending(item => item.CreatedAtUtc).ThenBy(item => item.Id))
                {
                    <div class="bl-dash-row"><BloodTypeBadge Value="need.BloodType" /><div class="bl-dash-row-main"><strong>@need.UnitsNeeded units - @BloodDisplay.UrgencyLabel(need.Urgency)</strong><span>@BloodDisplay.FormatTimestamp(need.CreatedAtUtc)</span></div><div class="bl-badge-row"><span>@BloodDisplay.BloodNeedStatusLabel(need.Status)</span><a href="@($"/needs/{need.Id}")">Open</a></div></div>
                }</div>
            }
        </section>
        <section class="bl-card"><div class="bl-card-head"><h2>Recent facility activity</h2></div>
            @if (_snapshot.RecentActivity.Count == 0) { <EmptyState Icon="history" Title="No recent activity" Description="Recorded facility activity will appear here." /> }
            else
            {
                <ol class="bl-list">@foreach (var activity in _snapshot.RecentActivity)
                {
                    <li class="bl-dash-row"><div class="bl-dash-row-main"><strong>@activity.Action</strong><span>@activity.Summary</span><time>@BloodDisplay.FormatTimestamp(activity.CreatedAtUtc)</time></div></li>
                }</ol>
            }
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private FacilityAdminDashboardDto? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        try { _snapshot = await Dashboard.GetFacilityAdminDashboardAsync(); }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException) { _error = "Your account or facility is not authorized for operational access."; }
        catch (Exception) { _error = "We could not load the facility snapshot. Please try again."; }
        finally { _loading = false; }
    }
}
