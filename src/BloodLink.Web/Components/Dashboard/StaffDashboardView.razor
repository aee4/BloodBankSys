@inject IDashboardService Dashboard

@if (_loading)
{
    <LoadingState Message="Loading your dashboard..." />
}
else if (_error is not null)
{
    <AlertMessage Variant="danger" Title="Could not load dashboard"><span>@_error</span></AlertMessage>
}
else if (_snapshot is not null)
{
    <div class="bl-dash-header">
        <div><h1 class="bl-dash-title">My dashboard</h1><p class="bl-dash-subtitle">Your submitted needs and account updates</p></div>
        <a class="bl-btn bl-btn-primary" href="/needs/new"><AppIcon Name="plus" Size="14" /> Submit need</a>
    </div>
    <div class="bl-stat-grid bl-stat-grid-4">
        <StatCard Label="Open needs" Value="@_snapshot.MyOpenNeeds.ToString()" Icon="clipboard-list" />
        <StatCard Label="Pending review" Value="@_snapshot.PendingReviewNeeds.ToString()" Icon="clock" />
        <StatCard Label="Searching" Value="@_snapshot.SearchingNeeds.ToString()" Icon="search" />
        <StatCard Label="Unread notifications" Value="@_snapshot.UnreadNotifications.ToString()" Icon="bell" />
    </div>
    <nav class="bl-quick-grid" aria-label="Need links">
        <a class="bl-quick-action" href="/needs/new"><AppIcon Name="plus" Size="16" /><span>Submit a need</span></a>
        <a class="bl-quick-action" href="/needs/mine"><AppIcon Name="clipboard-list" Size="16" /><span>My needs</span></a>
        <a class="bl-quick-action" href="/notifications"><AppIcon Name="bell" Size="16" /><span>Notifications</span></a>
    </nav>
    <section class="bl-card">
        <div class="bl-card-head"><h2>My recent needs</h2><a class="bl-link" href="/needs/mine">View all <AppIcon Name="chevron-right" Size="12" /></a></div>
        @if (_snapshot.RecentNeeds.Count == 0) { <EmptyState Icon="clipboard-list" Title="No submitted needs" Description="Your needs will appear here after you submit one." /> }
        else
        {
            <div class="bl-list">@foreach (var need in _snapshot.RecentNeeds.OrderByDescending(item => item.CreatedAtUtc).ThenBy(item => item.Id))
            {
                <div class="bl-dash-row"><BloodTypeBadge Value="need.BloodType" /><div class="bl-dash-row-main"><strong>@need.UnitsNeeded units - @BloodDisplay.UrgencyLabel(need.Urgency)</strong><span>@BloodDisplay.FormatTimestamp(need.CreatedAtUtc)</span></div><div class="bl-badge-row"><span>@BloodDisplay.BloodNeedStatusLabel(need.Status)</span><a href="@($"/needs/{need.Id}")">Details</a></div></div>
            }</div>
        }
    </section>
}

@code {
    private bool _loading = true;
    private string? _error;
    private StaffDashboardDto? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        try { _snapshot = await Dashboard.GetFacilityStaffDashboardAsync(); }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException) { _error = "Your account is not active for facility access."; }
        catch (Exception) { _error = "We could not load your dashboard. Please try again."; }
        finally { _loading = false; }
    }
}
