@inject IDashboardService Dashboard

@if (_loading)
{
    <LoadingState Message="Loading platform overview..." />
}
else if (_error is not null)
{
    <AlertMessage Variant="danger" Title="Could not load platform overview"><span>@_error</span></AlertMessage>
}
else if (_snapshot is not null)
{
    <div class="bl-dash-header"><div><h1 class="bl-dash-title">System dashboard</h1><p class="bl-dash-subtitle">Platform facilities, active requests and recorded activity</p></div></div>
    <div class="bl-stat-grid bl-stat-grid-4">
        <StatCard Label="Pending facilities" Value="@_snapshot.PendingFacilities.ToString()" Icon="clock" Accent="@(_snapshot.PendingFacilities > 0)" />
        <StatCard Label="Approved facilities" Value="@_snapshot.ApprovedFacilities.ToString()" Icon="circle-check" />
        <StatCard Label="Suspended facilities" Value="@_snapshot.SuspendedFacilities.ToString()" Icon="alert-triangle" Accent="@(_snapshot.SuspendedFacilities > 0)" />
        <StatCard Label="Active requests" Value="@_snapshot.ActiveRequests.ToString()" Icon="activity" Sub="Sent or accepted" />
    </div>
    <section class="bl-card"><div class="bl-card-head"><h2>Facilities awaiting review</h2><a class="bl-link" href="/system/facilities">Facility reviews <AppIcon Name="chevron-right" Size="12" /></a></div>
        @if (_snapshot.PendingReviews.Count == 0) { <EmptyState Icon="circle-check" Title="No pending facility reviews" Description="New facility registrations will appear here." /> }
        else
        {
            <div class="bl-list">@foreach (var facility in _snapshot.PendingReviews.OrderBy(item => item.CreatedAtUtc).ThenBy(item => item.Id))
            {
                <div class="bl-dash-row"><AppIcon Name="building" Size="15" /><div class="bl-dash-row-main"><strong>@facility.Name</strong><span>@facility.City, @facility.Region - @BloodDisplay.FormatTimestamp(facility.CreatedAtUtc)</span></div><a class="bl-link" href="@($"/system/facilities/{facility.Id}")">Review</a></div>
            }</div>
        }
    </section>
    <section class="bl-card"><div class="bl-card-head"><h2>Recent platform activity</h2></div>
        @if (_snapshot.RecentActivity.Count == 0) { <EmptyState Icon="history" Title="No recent activity" Description="Recorded platform events will appear here." /> }
        else
        {
            <ol class="bl-list">@foreach (var eventItem in _snapshot.RecentActivity)
            {
                <li class="bl-dash-row"><div class="bl-dash-row-main"><strong>@eventItem.Action</strong><span>@eventItem.Summary</span><time>@BloodDisplay.FormatTimestamp(eventItem.CreatedAtUtc)</time></div></li>
            }</ol>
        }
    </section>
}

@code {
    private bool _loading = true;
    private string? _error;
    private SystemDashboardDto? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        try { _snapshot = await Dashboard.GetSystemAdminDashboardAsync(); }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException) { _error = "Your account is not authorized for system administration."; }
        catch (Exception) { _error = "We could not load the platform snapshot. Please try again."; }
        finally { _loading = false; }
    }
}
