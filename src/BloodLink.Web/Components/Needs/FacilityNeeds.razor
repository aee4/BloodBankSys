@page "/needs"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.RequireFacilityAdmin)]
@inject IBloodNeedService Needs
@inject ICurrentUserService CurrentUser

<PageTitle>All Needs | BloodLink</PageTitle>

<div class="bl-dash-header">
    <div>
        <h1 class="bl-dash-title">All Needs</h1>
        <p class="bl-dash-subtitle">Blood needs across your facility</p>
    </div>
</div>

@if (_loading)
{
    <LoadingState Message="Loading needs..." />
}
else if (_error == "no-access")
{
    <AlertMessage Variant="danger" Title="No access">
        <span>Only facility administrators can view all facility needs. <a class="bl-inline-link" href="/needs/mine">View my needs</a>.</span>
    </AlertMessage>
}
else if (_error == "load")
{
    <AlertMessage Variant="danger" Title="Couldn't load needs">
        <span>We couldn't load facility needs right now. Please try again later.</span>
    </AlertMessage>
}
else
{
    <div class="bl-field bl-filter-control">
        <label class="bl-label" for="facility-need-filter">Status</label>
        <InputSelect id="facility-need-filter" class="bl-input bl-select" @bind-Value="_filter">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<BloodNeedStatus>())
            {
                <option value="@status">@BloodDisplay.BloodNeedStatusLabel(status)</option>
            }
        </InputSelect>
    </div>

    @if (!Filtered.Any())
    {
        <EmptyState Icon="clipboard-list" Title="@(_needs.Count == 0 ? "No needs" : "No matching needs")"
                    Description="@(_needs.Count == 0 ? "Staff submissions will appear here for review." : "Change the status filter to see another status.")" />
    }
    else
    {
        <section class="bl-card">
            <div class="bl-table-wrap">
                <table class="bl-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Blood Type</th>
                            <th>Units</th>
                            <th>Urgency</th>
                            <th>Requested by</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var need in Filtered)
                        {
                            <tr>
                                <td class="bl-mono">@BloodDisplay.ShortId(need.Id)</td>
                                <td><BloodTypeBadge Value="need.BloodType" /></td>
                                <td class="bl-strong">@need.UnitsNeeded</td>
                                <td><span class="bl-status-badge bl-status-@BloodDisplay.UrgencyTone(need.Urgency)">@BloodDisplay.UrgencyLabel(need.Urgency)</span></td>
                                <td>@(_details.TryGetValue(need.Id, out var detail) ? detail.CreatorDisplayName : "Staff member")</td>
                                <td><span class="bl-status-badge bl-status-@BloodDisplay.BloodNeedStatusTone(need.Status)">@BloodDisplay.BloodNeedStatusLabel(need.Status)</span></td>
                                <td class="bl-muted">@BloodDisplay.FormatTimestamp(need.CreatedAtUtc)</td>
                                <td><a class="bl-link" href="@($"/needs/{need.Id}")">Review <AppIcon Name="chevron-right" Size="12" /></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private string _filter = string.Empty;
    private IReadOnlyList<BloodNeedDto> _needs = [];
    private readonly Dictionary<Guid, BloodNeedDetailDto> _details = [];

    private IEnumerable<BloodNeedDto> Filtered =>
        _needs.Where(need => string.IsNullOrEmpty(_filter) || need.Status.ToString() == _filter)
            .OrderByDescending(need => need.CreatedAtUtc).ThenBy(need => need.Id);

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsInRole(RoleNames.FacilityAdmin))
        {
            _loading = false;
            _error = "no-access";
            return;
        }

        try
        {
            _needs = await Needs.ListOwnFacilityAsync();
            foreach (var need in _needs)
            {
                var detail = await Needs.GetAsync(need.Id);
                if (detail is not null)
                {
                    _details[need.Id] = detail;
                }
            }
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "no-access";
        }
        catch (Exception)
        {
            _error = "load";
        }
        finally
        {
            _loading = false;
        }
    }

}
