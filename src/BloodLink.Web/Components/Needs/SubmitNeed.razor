@page "/needs/new"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.RequireFacilityStaff)]
@inject IBloodNeedService Needs

<PageTitle>Submit Blood Need | BloodLink</PageTitle>

<div class="bl-dash-header">
    <div>
        <h1 class="bl-dash-title">Submit Blood Need</h1>
        <p class="bl-dash-subtitle">Request blood units for your facility</p>
    </div>
</div>

@if (_created is not null)
{
    <AlertMessage Variant="success" Title="Need submitted">
        <p>Your request was recorded and is pending facility review.</p>
        <p>Reference: <a class="bl-inline-link" href="@($"/needs/{_created.Id}")">Need @BloodDisplay.ShortId(_created.Id)</a></p>
        <a class="bl-btn bl-btn-outline" href="/needs/mine">View my needs</a>
    </AlertMessage>
}
else
{
    <section class="bl-card bl-card-pad">
        @if (_error is not null)
        {
            <AlertMessage Variant="danger" Title="Couldn't submit the need">
                <span>@_error</span>
            </AlertMessage>
        }

        <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="needs-submit">
            <DataAnnotationsValidator />
            <ValidationSummary class="bl-validation-summary" />
            <div class="bl-form-grid">
                <div class="bl-field">
                    <label class="bl-label" for="need-blood-type">Blood type <span>*</span></label>
                    <InputSelect id="need-blood-type" class="bl-input bl-select" @bind-Value="_model.BloodType">
                        <option value="">Select blood type</option>
                        @foreach (var value in Enum.GetValues<BloodType>())
                        {
                            <option value="@value">@BloodDisplay.BloodTypeLabel(value)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => _model.BloodType)" />
                </div>
                <div class="bl-field">
                    <label class="bl-label" for="need-units">Units needed <span>*</span></label>
                    <InputNumber id="need-units" class="bl-input" @bind-Value="_model.UnitsNeeded" min="1" />
                    <ValidationMessage For="@(() => _model.UnitsNeeded)" />
                </div>
                <div class="bl-field">
                    <label class="bl-label" for="need-urgency">Urgency <span>*</span></label>
                    <InputSelect id="need-urgency" class="bl-input bl-select" @bind-Value="_model.Urgency">
                        <option value="">Select urgency</option>
                        @foreach (var value in Enum.GetValues<UrgencyLevel>())
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => _model.Urgency)" />
                </div>
                <div class="bl-field">
                    <label class="bl-label" for="need-needed-by">Needed by <span>*</span></label>
                    <InputDate id="need-needed-by" class="bl-input" Type="InputDateType.DateTimeLocal" @bind-Value="_model.NeededBy" />
                    <ValidationMessage For="@(() => _model.NeededBy)" />
                </div>
            </div>
            <div class="bl-field bl-fieldset-gap">
                <label class="bl-label" for="need-note">Non-identifying clinical context</label>
                <InputTextArea id="need-note" class="bl-input bl-textarea" @bind-Value="_model.Note" rows="3" maxlength="1000" />
                <p class="bl-field-hint">Do not include patient names, record numbers, or other identifying information.</p>
            </div>
            <div class="bl-form-actions">
                <a class="bl-btn bl-btn-outline" href="/needs/mine">Cancel</a>
                <button class="bl-btn bl-btn-primary" type="submit" disabled="@_busy">
                    @if (_busy)
                    {
                        <AppIcon Name="loader" Size="16" Class="bl-spin" /> <span>Submitting...</span>
                    }
                    else
                    {
                        <span>Submit need</span>
                    }
                </button>
            </div>
        </EditForm>
    </section>
}

@code {
    private readonly NeedForm _model = new();
    private readonly NeedSubmissionGuard _submissionGuard = new();
    private bool _busy;
    private string? _error;
    private BloodNeedDto? _created;

    private async Task SubmitAsync()
    {
        if (!_submissionGuard.TryBegin())
        {
            return;
        }

        _busy = true;
        _error = null;
        var submitted = false;
        try
        {
            var neededBy = DateTime.SpecifyKind(_model.NeededBy!.Value, DateTimeKind.Local).ToUniversalTime();
            _created = await Needs.CreateAsync(new CreateBloodNeedRequest(
                _model.BloodType!.Value,
                _model.UnitsNeeded,
                _model.Urgency!.Value,
                neededBy,
                string.IsNullOrWhiteSpace(_model.Note) ? null : _model.Note.Trim()));
            submitted = true;
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "Your account is not authorized to submit a need.";
        }
        catch (ArgumentException)
        {
            _error = "Check the entered values and try again.";
        }
        catch (Exception)
        {
            _error = "The need was not confirmed as submitted. Please retry.";
        }
        finally
        {
            _submissionGuard.Complete(submitted);
            _busy = false;
        }
    }

    private sealed class NeedForm
    {
        [Required]
        public BloodType? BloodType { get; set; }

        [Required]
        [Range(1, int.MaxValue)]
        public int UnitsNeeded { get; set; }

        [Required]
        public UrgencyLevel? Urgency { get; set; }

        [Required]
        public DateTime? NeededBy { get; set; }

        [StringLength(1000)]
        public string? Note { get; set; }
    }
}
