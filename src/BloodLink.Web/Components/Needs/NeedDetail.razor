@page "/needs/{Id:guid}"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject IBloodNeedService Needs
@inject IInventoryService Inventory
@inject ICurrentUserService CurrentUser

<PageTitle>Need @BloodDisplay.ShortId(Id) | BloodLink</PageTitle>

@if (_loading)
{
    <LoadingState Message="Loading need..." />
}
else if (_notFound)
{
    <EmptyState Icon="search" Title="Need not found" Description="This need could not be found or you do not have access to it.">
        <a class="bl-btn bl-btn-primary" href="@BackHref">Back to @BackLabel</a>
    </EmptyState>
}
else if (_loadError || _need is null)
{
    <AlertMessage Variant="danger" Title="Could not load need">
        <span>We could not load this need right now. Please try again.</span>
    </AlertMessage>
}
else
{
    <nav class="bl-breadcrumb" aria-label="Breadcrumb">
        <a href="@BackHref">@BackLabel</a>
        <AppIcon Name="chevron-right" Size="12" />
        <span>Need @BloodDisplay.ShortId(_need.Id)</span>
    </nav>

    @if (_actionError is not null)
    {
        <AlertMessage Variant="danger" Title="Need was not updated"><span>@_actionError</span></AlertMessage>
    }
    @if (_success is not null)
    {
        <AlertMessage Variant="success" Title="Need updated"><span>@_success</span></AlertMessage>
    }

    <div class="bl-detail-grid">
        <main class="bl-detail-main">
            <section class="bl-card bl-card-pad">
                <div class="bl-detail-head">
                    <div>
                        <h1 class="bl-detail-title">Blood Need @BloodDisplay.ShortId(_need.Id)</h1>
                        <p class="bl-detail-sub">@_need.FacilityName</p>
                    </div>
                    <div class="bl-badge-row">
                        <span class="bl-status-badge bl-status-@BloodDisplay.UrgencyTone(_need.Urgency)">@BloodDisplay.UrgencyLabel(_need.Urgency)</span>
                        <span class="bl-status-badge bl-status-@BloodDisplay.BloodNeedStatusTone(_need.Status)">@BloodDisplay.BloodNeedStatusLabel(_need.Status)</span>
                    </div>
                </div>
                <dl class="bl-detail-facts">
                    <div><dt class="bl-detail-label">Blood type</dt><dd><BloodTypeBadge Value="_need.BloodType" /></dd></div>
                    <div><dt class="bl-detail-label">Units needed</dt><dd class="bl-detail-fact-lg">@_need.UnitsNeeded</dd></div>
                    <div><dt class="bl-detail-label">Requested by</dt><dd>@_need.CreatorDisplayName</dd></div>
                    <div><dt class="bl-detail-label">Needed by</dt><dd>@BloodDisplay.FormatTimestamp(_need.NeededByUtc)</dd></div>
                    <div><dt class="bl-detail-label">Submitted</dt><dd>@BloodDisplay.FormatTimestamp(_need.CreatedAtUtc)</dd></div>
                    <div><dt class="bl-detail-label">Last updated</dt><dd>@BloodDisplay.FormatTimestamp(_need.UpdatedAtUtc)</dd></div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(_need.Note))
                {
                    <div class="bl-detail-context"><h2 class="bl-card-title">Submitted context</h2><p>@_need.Note</p></div>
                }
                @if (!string.IsNullOrWhiteSpace(_need.DecisionReason))
                {
                    <div class="bl-detail-context"><h2 class="bl-card-title">Latest decision</h2><p>@_need.DecisionReason</p></div>
                }
            </section>

            <section class="bl-card bl-card-pad" aria-labelledby="need-inventory-title">
                <h2 id="need-inventory-title" class="bl-card-title">Matching facility inventory</h2>
                @if (_need.InventoryTotalUnits is { } total && _need.InventoryReservedUnits is { } reserved && _need.InventoryAvailableUnits is { } available)
                {
                    <dl class="bl-detail-facts">
                        <div><dt class="bl-detail-label">Total</dt><dd>@total</dd></div>
                        <div><dt class="bl-detail-label">Reserved</dt><dd>@reserved</dd></div>
                        <div><dt class="bl-detail-label">Available</dt><dd>@available</dd></div>
                        <div><dt class="bl-detail-label">Stock level</dt><dd>@(_lowStock ? "At or below low-stock threshold" : "Above low-stock threshold")</dd></div>
                    </dl>
                }
                else
                {
                    <p>No matching inventory record is currently available.</p>
                }
            </section>

            @if (_isAdmin && _need.Status == BloodNeedStatus.Searching)
            {
                <section class="bl-card bl-card-pad">
                    <h2 class="bl-card-title">Find an external source</h2>
                    <p class="bl-card-desc">Search approved facilities for this need's exact blood type and quantity.</p>
                    <a class="bl-btn bl-btn-primary" href="@($"/inventory/search?needId={_need.Id}")"><AppIcon Name="search" Size="14" /> Search network</a>
                </section>
            }

            @if (HasActions)
            {
                <section class="bl-card bl-card-pad">
                    <h2 class="bl-card-title">Need actions</h2>
                    @if (_confirming is not null)
                    {
                        <div class="bl-confirm-box" aria-live="polite">
                            <p class="bl-card-desc">@ConfirmationText</p>
                            @if (_confirming is "reject" or "cancel")
                            {
                                <label class="bl-label" for="need-action-reason">Reason <span>*</span></label>
                                <InputTextArea id="need-action-reason" class="bl-input bl-textarea" @bind-Value="_reason" rows="3" maxlength="1000" />
                            }
                            else if (_confirming == "fulfil")
                            {
                                <p class="bl-warning-note">This consumes exactly @_need.UnitsNeeded available units from local stock.</p>
                                <label class="bl-label" for="need-action-reason">Note (optional)</label>
                                <InputText id="need-action-reason" class="bl-input" @bind-Value="_reason" maxlength="1000" />
                            }
                            <div class="bl-confirm-actions">
                                <button class="bl-btn bl-btn-outline" type="button" @onclick="ClearConfirmation" disabled="@_busy">Keep need</button>
                                <button class="bl-btn bl-btn-primary" type="button" @onclick="RunActionAsync" disabled="@(_busy || (RequiresReason && string.IsNullOrWhiteSpace(_reason)))">
                                    @(_busy ? "Working..." : "Confirm")
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bl-action-row">
                            @if (_canStartSearch) { <button class="bl-btn bl-btn-outline" type="button" @onclick='() => Begin("search")' disabled="@_busy">Start searching</button> }
                            @if (_canFulfil) { <button class="bl-btn bl-btn-primary" type="button" @onclick='() => Begin("fulfil")' disabled="@_busy">Fulfil internally</button> }
                            @if (_canReject) { <button class="bl-btn bl-btn-danger" type="button" @onclick='() => Begin("reject")' disabled="@_busy">Reject</button> }
                            @if (_canCancel) { <button class="bl-btn bl-btn-outline" type="button" @onclick='() => Begin("cancel")' disabled="@_busy">Cancel need</button> }
                        </div>
                    }
                </section>
            }
        </main>

        <aside class="bl-card bl-card-pad bl-detail-aside" aria-labelledby="need-timeline-title">
            <h2 id="need-timeline-title" class="bl-card-title">Status timeline</h2>
            @if (_timeline.Count == 0)
            {
                <p class="bl-muted">No persisted status history is available.</p>
            }
            else
            {
                <ol class="bl-timeline">
                    @foreach (var item in _timeline)
                    {
                        <li class="bl-timeline-item">
                            <span class="bl-timeline-dot"></span>
                            <div>
                                <p class="bl-timeline-event">@(item.FromStatus is null ? "Submitted" : BloodDisplay.BloodNeedStatusLabel(item.FromStatus.Value)) <span aria-hidden="true">&rarr;</span> @BloodDisplay.BloodNeedStatusLabel(item.ToStatus)</p>
                                <p class="bl-timeline-time">@BloodDisplay.FormatTimestamp(item.ChangedAtUtc) by @item.ActorDisplayName</p>
                                @if (!string.IsNullOrWhiteSpace(item.Note)) { <p>@item.Note</p> }
                            </div>
                        </li>
                    }
                </ol>
            }
        </aside>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private bool _notFound;
    private bool _loadError;
    private bool _busy;
    private bool _isAdmin;
    private bool _isCreator;
    private bool _lowStock;
    private string? _confirming;
    private string? _reason;
    private string? _actionError;
    private string? _success;
    private BloodNeedDetailDto? _need;
    private IReadOnlyList<BloodNeedTimelineItemDto> _timeline = [];

    private string BackLabel => _isAdmin ? "Facility needs" : "My needs";
    private string BackHref => _isAdmin ? "/needs" : "/needs/mine";
    private bool _canStartSearch => _isAdmin && _need?.Status == BloodNeedStatus.PendingReview;
    private bool _canFulfil => _isAdmin && _need?.Status is BloodNeedStatus.PendingReview or BloodNeedStatus.Searching;
    private bool _canReject => _isAdmin && _need?.Status == BloodNeedStatus.PendingReview;
    private bool _canCancel => (_isAdmin && _need?.Status is BloodNeedStatus.PendingReview or BloodNeedStatus.Searching)
        || (_isCreator && _need?.Status == BloodNeedStatus.PendingReview);
    private bool HasActions => _canStartSearch || _canFulfil || _canReject || _canCancel;
    private bool RequiresReason => _confirming is "reject" or "cancel";
    private string ConfirmationText => _confirming switch
    {
        "search" => "Move this need into network sourcing?",
        "fulfil" => "Confirm internal fulfilment from matching local inventory.",
        "reject" => "Reject this need? The reason will be recorded in its history.",
        _ => "Cancel this need? The reason will be recorded in its history."
    };

    protected override async Task OnParametersSetAsync()
    {
        _isAdmin = CurrentUser.IsInRole(RoleNames.FacilityAdmin);
        _isCreator = CurrentUser.IsInRole(RoleNames.FacilityStaff);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = false;
        try
        {
            _need = await Needs.GetAsync(Id);
            if (_need is null)
            {
                _notFound = true;
                return;
            }
            _notFound = false;
            _timeline = await Needs.GetTimelineAsync(Id);
            var stock = (await Inventory.GetOwnInventoryAsync()).FirstOrDefault(item => item.BloodType == _need.BloodType);
            _lowStock = stock is not null && stock.AvailableUnits <= stock.LowStockThreshold;
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _notFound = true;
        }
        catch (System.UnauthorizedAccessException)
        {
            _notFound = true;
        }
        catch (Exception)
        {
            _loadError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void Begin(string action)
    {
        _confirming = action;
        _reason = string.Empty;
        _actionError = null;
        _success = null;
    }

    private void ClearConfirmation()
    {
        _confirming = null;
        _reason = null;
    }

    private async Task RunActionAsync()
    {
        if (_need is null || _confirming is null || _busy) return;
        _busy = true;
        _actionError = null;
        _success = null;
        try
        {
            switch (_confirming)
            {
                case "search": await Needs.StartSearchAsync(new NeedDecisionRequest(_need.Id, null)); break;
                case "fulfil": await Needs.FulfilInternallyAsync(new NeedDecisionRequest(_need.Id, TrimReason())); break;
                case "reject": await Needs.RejectAsync(new NeedDecisionRequest(_need.Id, TrimReason())); break;
                case "cancel": await Needs.CancelAsync(new NeedDecisionRequest(_need.Id, TrimReason())); break;
            }
            ClearConfirmation();
            await LoadAsync();
            _success = "The need transition was saved and its current status and timeline have been refreshed.";
        }
        catch (BloodLink.Domain.Exceptions.ConcurrencyException)
        {
            _actionError = "This need or its inventory changed while you were acting. Refresh the record and try again.";
            await LoadAsync();
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _actionError = "Your account is not authorized for this action.";
        }
        catch (Exception)
        {
            _actionError = "The action could not be completed. The need may have changed; refresh and review its current state.";
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private string? TrimReason() => string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim();
}
