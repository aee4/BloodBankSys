@page "/account/reset-password"
@layout PublicLayout

<PageTitle>Reset Password | BloodLink</PageTitle>
<main class="bl-auth-page">
    <AuthAside />
    <section class="bl-auth-content">
        <div class="bl-auth-panel">
            <h1>Reset your password</h1>
            <p>Choose a password with at least 8 characters, including uppercase, lowercase and a number.</p>
            @if (Status == "invalid" || string.IsNullOrEmpty(Code))
            {
                <AlertMessage Variant="danger">The reset could not be completed. Reopen your reset link and check the password requirements, or request a new link.</AlertMessage>
                <a href="/account/forgot-password">Request reset instructions</a>
            }
            @if (!string.IsNullOrEmpty(Code))
            {
                <form method="post" action="/account/reset-password" class="bl-auth-form" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="Code" value="@Code" />
                    <label for="email">Account email</label>
                    <input class="bl-input" id="email" name="Email" type="email" value="@Email" maxlength="256" autocomplete="username" required />
                    <label for="new-password">New password</label>
                    <input class="bl-input" id="new-password" name="NewPassword" type="password" autocomplete="new-password" minlength="8" maxlength="256" required />
                    <label for="confirm-password">Confirm new password</label>
                    <input class="bl-input" id="confirm-password" name="ConfirmPassword" type="password" autocomplete="new-password" maxlength="256" required />
                    <button class="bl-btn bl-btn-danger" type="submit">Reset password</button>
                </form>
            }
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
}
