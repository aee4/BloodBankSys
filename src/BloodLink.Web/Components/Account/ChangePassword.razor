@page "/account/change-password"
@layout PublicLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = BloodLink.Infrastructure.Identity.AccountSessionRequirement.Policy)]

<PageTitle>Change Password | BloodLink</PageTitle>
<main class="bl-auth-page">
    <AuthAside />
    <section class="bl-auth-content">
        <div class="bl-auth-panel">
            <h1>Change your password</h1>
            <p>Enter your current or temporary password and choose a different password with at least 8 characters, including uppercase, lowercase and a number.</p>
            @if (Status == "invalid") { <AlertMessage Variant="danger">Password change failed. Check your current password and the new password requirements.</AlertMessage> }
            <form method="post" action="/account/change-password" class="bl-auth-form" data-enhance="false">
                <AntiforgeryToken />
                <label for="current-password">Current password</label>
                <input class="bl-input" id="current-password" name="CurrentPassword" type="password" autocomplete="current-password" maxlength="256" required />
                <label for="new-password">New password</label>
                <input class="bl-input" id="new-password" name="NewPassword" type="password" autocomplete="new-password" minlength="8" maxlength="256" required />
                <label for="confirm-password">Confirm new password</label>
                <input class="bl-input" id="confirm-password" name="ConfirmPassword" type="password" autocomplete="new-password" maxlength="256" required />
                <button class="bl-btn bl-btn-danger" type="submit">Change password</button>
            </form>
            <form method="post" action="/account/logout" data-enhance="false">
                <p>Signing out ends your sessions on all devices.</p>
                <AntiforgeryToken />
                <button class="bl-btn" type="submit">Sign out</button>
            </form>
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery] public string? Status { get; set; }
}
