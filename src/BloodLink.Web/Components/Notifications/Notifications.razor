@page "/notifications"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject INotificationService NotificationService
@inject ICurrentUserService CurrentUser

<PageTitle>Notifications | BloodLink</PageTitle>

<div class="bl-dash-header">
    <div><h1 class="bl-dash-title">Notifications</h1><p class="bl-dash-subtitle">Updates for your account</p></div>
    @if (_unreadCount > 0)
    {
        <button class="bl-btn bl-btn-outline" type="button" @onclick="MarkAllReadAsync" disabled="@_busy">
            <AppIcon Name="check" Size="14" /> Mark all read (@_unreadCount)
        </button>
    }
</div>

@if (_loading)
{
    <LoadingState Message="Loading notifications..." />
}
else if (_loadError is not null)
{
    <AlertMessage Variant="danger" Title="Could not load notifications"><span>@_loadError</span></AlertMessage>
}
else if (_actionError is not null)
{
    <AlertMessage Variant="danger" Title="Notification state not confirmed"><span>@_actionError</span></AlertMessage>
}

@if (!_loading && _notifications.Count == 0)
{
    <EmptyState Icon="bell" Title="No notifications" Description="Updates about needs, requests and your facility will appear here." />
}
else if (!_loading && _notifications.Count > 0)
{
    <section class="bl-card" aria-label="Your notifications">
        <ul class="bl-note-list">
            @foreach (var item in _notifications)
            {
                <li class="bl-note-item @(item.IsRead ? "bl-note-read" : "bl-note-unread")">
                    <span class="bl-note-icon"><AppIcon Name="@BloodDisplay.NotificationTypeIcon(item.NotificationType)" Size="16" /></span>
                    <div class="bl-note-body">
                        <div class="bl-note-head"><span class="bl-note-type">@BloodDisplay.NotificationTypeLabel(item.NotificationType)</span><time class="bl-note-time">@BloodDisplay.FormatTimestamp(item.CreatedAtUtc)</time></div>
                        <p class="bl-note-title">@item.Title</p>
                        @if (!string.IsNullOrWhiteSpace(item.Message)) { <p class="bl-note-message">@item.Message</p> }
                        @if (RelatedHref(item) is { } href) { <a class="bl-inline-link" href="@href">Open related record</a> }
                    </div>
                    <div class="bl-note-actions">
                        <span>@(item.IsRead ? "Read" : "Unread")</span>
                        @if (!item.IsRead)
                        {
                            <button class="bl-btn-sm" type="button" @onclick="() => MarkItemReadAsync(item)" disabled="@_busy">Mark read</button>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _loadError;
    private string? _actionError;
    private int _unreadCount;
    private IReadOnlyList<NotificationDto> _notifications = [];

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            var notifications = await NotificationService.ListMineAsync();
            var count = await NotificationService.GetUnreadCountAsync();
            _notifications = notifications;
            _unreadCount = count.Count;
            _loadError = null;
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _loadError = "Your account is not authorized to view notifications.";
        }
        catch (Exception)
        {
            _loadError = "We could not load your notifications. Please try again.";
        }
        finally { _loading = false; }
    }

    private async Task MarkItemReadAsync(NotificationDto item)
    {
        if (item.IsRead || _busy) return;
        _busy = true;
        _actionError = null;
        try
        {
            await NotificationService.MarkReadAsync(item.Id);
            _notifications = _notifications.Select(current => current.Id == item.Id ? current with { IsRead = true } : current).ToList();
            _unreadCount = Math.Max(0, _unreadCount - 1);
            await RefreshUnreadCountAsync();
        }
        catch (Exception)
        {
            _actionError = "We could not confirm this notification as read. Its displayed state was not changed.";
        }
        finally { _busy = false; }
    }

    private async Task MarkAllReadAsync()
    {
        if (_busy || _unreadCount == 0) return;
        _busy = true;
        _actionError = null;
        try
        {
            await NotificationService.MarkAllReadAsync();
            _notifications = _notifications.Select(item => item with { IsRead = true }).ToList();
            _unreadCount = 0;
            await RefreshUnreadCountAsync();
        }
        catch (Exception)
        {
            _actionError = "We could not confirm all notifications as read. Please refresh and check their current state.";
        }
        finally { _busy = false; }
    }

    private async Task RefreshUnreadCountAsync()
    {
        try { _unreadCount = (await NotificationService.GetUnreadCountAsync()).Count; }
        catch (Exception) { _actionError = "Read state was saved, but the unread count could not be refreshed."; }
    }

    private string? RelatedHref(NotificationDto item)
    {
        if (item.RelatedEntityId is not { } id) return null;
        return item.RelatedEntityType switch
        {
            nameof(BloodNeed) when CurrentUser.IsInRole(RoleNames.FacilityAdmin) || CurrentUser.IsInRole(RoleNames.FacilityStaff) => $"/needs/{id}",
            nameof(BloodRequest) when CurrentUser.IsInRole(RoleNames.FacilityAdmin) => $"/requests/{id}",
            nameof(Facility) when CurrentUser.IsInRole(RoleNames.SystemAdmin) => $"/system/facilities/{id}",
            nameof(Facility) when CurrentUser.IsInRole(RoleNames.FacilityAdmin) => "/facility/profile",
            nameof(FacilityStaff) when CurrentUser.IsInRole(RoleNames.FacilityAdmin) => "/facility/staff",
            _ => null
        };
    }
}
