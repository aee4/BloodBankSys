@page "/system/facilities"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.RequireSystemAdmin)]
@inject IFacilityService Facilities
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>Facilities | BloodLink | System</PageTitle>

<div class="bl-dash-header">
    <div>
        <h1 class="bl-dash-title">Facility Approvals</h1>
        <p class="bl-dash-subtitle">Registered facilities and lifecycle decisions</p>
    </div>
</div>

<section class="bl-card bl-card-pad">
    <label class="bl-label" for="facility-status-filter">Status filter</label>
    <InputSelect id="facility-status-filter" class="bl-input" @bind-Value="_statusFilter" @bind-Value:after="LoadAsync">
        <option value="">All statuses</option>
        @foreach (var status in Enum.GetValues<FacilityStatus>())
        {
            <option value="@status">@BloodDisplay.FacilityStatusLabel(status)</option>
        }
    </InputSelect>
</section>

@if (_loading)
{
    <LoadingState Message="Loading facilities..." />
}
else if (_error == "no-access")
{
    <AlertMessage Variant="danger" Title="No access">
        <span>Only system administrators can review facility registrations.</span>
    </AlertMessage>
}
else if (_error == "load")
{
    <AlertMessage Variant="danger" Title="Couldn't load facilities">
        <span>We couldn't load the facility list right now. Please try again later.</span>
    </AlertMessage>
}
else if (_facilities.Count == 0)
{
    <EmptyState Icon="building" Title="No facilities pending review"
                Description="No registered facilities match the current filter." />
}
else
{
    <section class="bl-card">
        <div class="bl-table-wrap">
            <table class="bl-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Reg. Number</th>
                        <th>Status</th>
                        <th>Registered</th>
                        <th>Region</th>
                        <th>City</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var facility in _facilities)
                    {
                        <tr class="bl-tr-click" @onclick="() => Go(facility.Id)">
                            <td class="bl-strong">@facility.Name</td>
                            <td class="bl-muted">@BloodDisplay.FacilityTypeLabel(facility.FacilityType)</td>
                            <td class="bl-mono bl-muted">@facility.RegistrationNumber</td>
                            <td>
                                <span class="bl-status-badge bl-status-@BloodDisplay.FacilityStatusTone(facility.Status)">
                                    @BloodDisplay.FacilityStatusLabel(facility.Status)
                                </span>
                            </td>
                            <td class="bl-muted">@BloodDisplay.FormatTimestamp(facility.CreatedAtUtc)</td>
                            <td class="bl-muted">@facility.Region</td>
                            <td class="bl-muted">@facility.City</td>
                            <td class="bl-right">
                                <span class="bl-btn-sm bl-inline-link">Review</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<FacilityDto> _facilities = [];
    private FacilityStatus? _statusFilter = FacilityStatus.Pending;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        if (!CurrentUser.IsInRole(RoleNames.SystemAdmin))
        {
            _loading = false;
            _error = "no-access";
            return;
        }

        try
        {
            _facilities = await Facilities.ListFacilitiesAsync(new FacilityQueryRequest(_statusFilter));
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "no-access";
        }
        catch (Exception)
        {
            _error = "load";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Go(Guid id) => Nav.NavigateTo($"/system/facilities/{id}");
}
