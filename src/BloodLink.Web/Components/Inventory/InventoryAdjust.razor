@page "/inventory/adjust"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.RequireFacilityAdmin)]
@inject IInventoryService Inventory
@inject ICurrentUserService CurrentUser

<PageTitle>Adjust Inventory | BloodLink</PageTitle>

<div class="bl-breadcrumb">
    <a href="/inventory">Inventory</a>
    <AppIcon Name="chevron-right" Size="12" />
    <span>Adjust</span>
</div>

@if (_error == "no-access")
{
    <AlertMessage Variant="danger" Title="No access">
        <span>Only active facility administrators can adjust inventory. <a class="bl-inline-link" href="/inventory">View inventory</a>.</span>
    </AlertMessage>
}
else
{
    <div class="bl-dash-header">
        <div>
            <h1 class="bl-dash-title">Adjust Inventory</h1>
            <p class="bl-dash-subtitle">Record a stock change for your facility</p>
        </div>
    </div>

    @if (_loading)
    {
        <LoadingState Message="Loading current inventory..." />
    }
    else if (_submitted)
    {
        <section class="bl-card bl-card-pad bl-success-card" aria-live="polite">
            <span class="bl-success-icon"><AppIcon Name="circle-check" Size="32" /></span>
            <h1>Adjustment Recorded</h1>
            <p>Inventory updated and exactly one transaction was added to the immutable history.</p>
            <div class="bl-form-actions">
                <button class="bl-btn bl-btn-outline" type="button" @onclick="Reset">Another</button>
                <a class="bl-btn bl-btn-outline" href="/inventory/history">View History</a>
                <a class="bl-btn bl-btn-primary" href="/inventory">Back to Inventory</a>
            </div>
        </section>
    }
    else
    {
        <section class="bl-card bl-card-pad">
            <EditForm Model="_model" OnValidSubmit="HandleSubmit" FormName="inventory-adjust">
                <ValidationSummary />

                @if (_message is { Length: > 0 })
                {
                    <AlertMessage Variant="@_messageVariant" Title="@_messageTitle">
                        <span>@_message</span>
                        @if (_messageKind == "concurrency")
                        {
                            <div class="bl-form-actions">
                                <button class="bl-btn bl-btn-outline" type="button" @onclick="ReloadCurrentValuesAsync" disabled="@_busy">
                                    Reload Current Values
                                </button>
                            </div>
                        }
                    </AlertMessage>
                }

                <div class="bl-form-grid">
                    <div class="bl-field">
                        <label class="bl-label" for="inv-blood-type">Blood Type <span>*</span></label>
                        <InputSelect id="inv-blood-type" class="bl-input bl-select" @bind-Value="_model.BloodType" @bind-Value:after="SelectBloodTypeAsync">
                            <option value="">Select blood type</option>
                            @foreach (var type in BloodTypes)
                            {
                                <option value="@type">@BloodDisplay.BloodTypeLabel(type)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="bl-field">
                        <label class="bl-label" for="inv-units">Signed unit change <span>*</span></label>
                        <InputNumber id="inv-units" class="bl-input" @bind-Value="_model.Units" placeholder="e.g. 10 or -3" />
                        <p class="bl-field-hint">Use a positive value to add stock and a negative value to remove stock. Zero is rejected.</p>
                    </div>
                </div>

                @if (_selected is not null || _model.BloodType is not null)
                {
                    var item = _selected;
                    <section class="bl-card bl-card-pad bl-card-inline" aria-live="polite">
                        <h2 class="bl-card-title">Current @BloodDisplay.BloodTypeLabel(_model.BloodType!.Value) Context</h2>
                        <div class="bl-detail-grid">
                            <div><p class="bl-label-optional">Total</p><p class="bl-strong">@(item?.TotalUnits ?? 0)</p></div>
                            <div><p class="bl-label-optional">Reserved</p><p class="bl-strong">@(item?.ReservedUnits ?? 0)</p></div>
                            <div><p class="bl-label-optional">Available</p><p class="bl-strong">@(item?.AvailableUnits ?? 0)</p></div>
                            <div><p class="bl-label-optional">Threshold</p><p class="bl-strong">@(item?.LowStockThreshold ?? 10)</p></div>
                            <div><p class="bl-label-optional">Last Updated</p><p class="bl-strong">@(item?.UpdatedAtUtc is { } updated ? BloodDisplay.FormatTimestamp(updated) : "Never")</p></div>
                        </div>
                    </section>
                }

                <div class="bl-field">
                    <label class="bl-label" for="inv-reason">Reason <span>*</span></label>
                    <InputTextArea id="inv-reason" class="bl-input bl-textarea" @bind-Value="_model.Reason" rows="3"
                                   placeholder="Required - describe why this stock change is being recorded" />
                </div>

                <div class="bl-form-actions">
                    <a class="bl-btn bl-btn-outline" href="/inventory">Cancel</a>
                    <button class="bl-btn bl-btn-primary" type="submit" disabled="@(_busy || _messageKind == "concurrency")">
                        @if (_busy) { <AppIcon Name="loader" Size="16" Class="bl-spin" /> <span>Recording...</span> }
                        else { <span>Record Adjustment</span> }
                    </button>
                </div>
            </EditForm>
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "bloodType")] public string? InitialBloodType { get; set; }

    private readonly AdjustForm _model = new();
    private bool _loading = true;
    private bool _busy;
    private bool _submitted;
    private string? _error;
    private string? _message;
    private string _messageVariant = "danger";
    private string _messageTitle = "Check the adjustment";
    private string? _messageKind;
    private IReadOnlyList<InventoryItemDto> _inventory = [];
    private InventoryItemDto? _selected;

    private static readonly BloodType[] BloodTypes = Enum.GetValues<BloodType>();

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsInRole(RoleNames.FacilityAdmin))
        {
            _error = "no-access";
            _loading = false;
            return;
        }

        if (Enum.TryParse<BloodType>(InitialBloodType, ignoreCase: false, out var bloodType))
        {
            _model.BloodType = bloodType;
        }
        await LoadInventoryAsync();
    }

    private async Task LoadInventoryAsync()
    {
        _loading = true;
        try
        {
            _inventory = await Inventory.GetOwnInventoryAsync();
            UpdateSelected();
            _error = null;
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "no-access";
        }
        catch (Exception)
        {
            SetMessage("Couldn't load current inventory. Please try again later.", "danger", "Couldn't load inventory");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectBloodTypeAsync()
    {
        await ReloadCurrentValuesAsync(clearMessage: true);
    }

    private async Task ReloadCurrentValuesAsync() => await ReloadCurrentValuesAsync(clearMessage: true);

    private async Task ReloadCurrentValuesAsync(bool clearMessage)
    {
        try
        {
            _inventory = await Inventory.GetOwnInventoryAsync();
            UpdateSelected();
            if (clearMessage)
            {
                ClearMessage();
            }
        }
        catch (Exception)
        {
            SetMessage("Couldn't reload current inventory. Please try again.", "danger", "Reload failed");
        }
    }

    private void UpdateSelected()
    {
        _selected = _model.BloodType is { } bloodType
            ? _inventory.FirstOrDefault(item => item.BloodType == bloodType)
            : null;
    }

    private void Reset()
    {
        _model.BloodType = null;
        _model.Units = null;
        _model.Reason = string.Empty;
        _selected = null;
        _submitted = false;
        ClearMessage();
    }

    private async Task HandleSubmit()
    {
        ClearMessage();

        if (_model.BloodType is not { } bloodType)
        {
            SetMessage("Select a blood type before recording an adjustment.", "danger", "Blood type required");
            return;
        }
        if (_model.Units is not { } units || units == 0)
        {
            SetMessage("Enter a non-zero signed unit change.", "danger", "Unit change required");
            return;
        }
        if (string.IsNullOrWhiteSpace(_model.Reason))
        {
            SetMessage("A reason is required for every inventory adjustment.", "danger", "Reason required");
            return;
        }

        _busy = true;
        try
        {
            await Inventory.AdjustInventoryAsync(new InventoryAdjustmentRequest(
                bloodType,
                units,
                _model.Reason.Trim(),
                _selected?.RowVersion));
            _submitted = true;
        }
        catch (BloodLink.Domain.Exceptions.ConcurrencyException)
        {
            await ReloadCurrentValuesAsync(clearMessage: false);
            SetMessage("Inventory changed after this page loaded. Reload the current values before trying again.", "danger", "Stale inventory values", "concurrency");
        }
        catch (BloodLink.Domain.Exceptions.InsufficientInventoryException)
        {
            await ReloadCurrentValuesAsync(clearMessage: false);
            SetMessage("This adjustment would make total units fall below reserved units. Current reservations must remain protected.", "danger", "Insufficient stock");
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "no-access";
        }
        catch (ArgumentException ex)
        {
            SetMessage(ex.Message, "danger", "Check the form");
        }
        catch (Exception)
        {
            SetMessage("We couldn't record the adjustment. Please try again later.", "danger", "Adjustment not recorded");
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetMessage(string message, string variant, string title, string? kind = null)
    {
        _message = message;
        _messageVariant = variant;
        _messageTitle = title;
        _messageKind = kind;
    }

    private void ClearMessage()
    {
        _message = null;
        _messageKind = null;
    }

    private sealed class AdjustForm
    {
        public BloodType? BloodType { get; set; }
        public int? Units { get; set; }
        public string Reason { get; set; } = string.Empty;
    }
}
