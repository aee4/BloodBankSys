@page "/inventory"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.RequireApprovedFacilityUser)]
@inject IInventoryService InventoryService
@inject ICurrentUserService CurrentUser

<PageTitle>Inventory | BloodLink</PageTitle>

<div class="bl-dash-header">
    <div>
        <h1 class="bl-dash-title">Inventory</h1>
        <p class="bl-dash-subtitle">Current blood stock at your facility</p>
    </div>
    <div class="bl-action-row">
        <a class="bl-btn bl-btn-outline" href="/inventory/history"><AppIcon Name="history" Size="14" /> History</a>
        @if (_isAdmin)
        {
            <a class="bl-btn bl-btn-outline" href="/inventory/search"><AppIcon Name="search" Size="14" /> Network Search</a>
            <a class="bl-btn bl-btn-primary" href="/inventory/adjust"><AppIcon Name="upload" Size="14" /> Adjust Inventory</a>
        }
    </div>
</div>

@if (_loading)
{
    <LoadingState Message="Loading inventory..." />
}
else if (_error == "no-access")
{
    <AlertMessage Variant="danger" Title="No access">
        <span>Your account is not active for approved facility inventory access.</span>
    </AlertMessage>
}
else if (_error == "load")
{
    <AlertMessage Variant="danger" Title="Couldn't load inventory">
        <span>We couldn't load inventory right now. Please try again later.</span>
    </AlertMessage>
}
else
{
    @if (!_isAdmin)
    {
        <AlertMessage Variant="neutral" Title="View-only inventory">
            <span>Facility staff can review stock levels, but only facility administrators can record adjustments or search the network.</span>
        </AlertMessage>
    }

    <section class="bl-card" aria-labelledby="inventory-table-title">
        <div class="bl-card-head">
            <h2 id="inventory-table-title">All Blood Types</h2>
            <button class="bl-btn-sm" type="button" @onclick="LoadAsync" disabled="@_loading">Refresh</button>
        </div>
        <div class="bl-table-wrap">
            <table class="bl-table">
                <thead>
                    <tr>
                        <th>Blood Type</th>
                        <th>Total</th>
                        <th>Reserved</th>
                        <th>Available</th>
                        <th>Low Threshold</th>
                        <th>Status</th>
                        <th>Last Updated</th>
                        @if (_isAdmin) { <th>Action</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bloodType in BloodTypes)
                    {
                        var item = FindItem(bloodType);
                        var total = item?.TotalUnits ?? 0;
                        var reserved = item?.ReservedUnits ?? 0;
                        var available = Math.Max(total - reserved, 0);
                        var threshold = item?.LowStockThreshold ?? DefaultLowStockThreshold;
                        var status = item is null
                            ? "No stock recorded"
                            : available <= threshold ? "Low stock" : "Healthy";
                        <tr>
                            <td><BloodTypeBadge Value="@bloodType" /></td>
                            <td class="bl-strong">@total</td>
                            <td>@reserved</td>
                            <td class="bl-strong">@available</td>
                            <td>@threshold</td>
                            <td>
                                <span class="bl-status-badge bl-status-@(item is null ? "neutral" : available <= threshold ? "danger" : "success")">
                                    @status
                                </span>
                                @if (item is not null && available <= threshold)
                                {
                                    <div class="bl-muted">Available units are at or below the configured threshold.</div>
                                }
                            </td>
                            <td class="bl-muted">@(item?.UpdatedAtUtc is { } updated ? BloodDisplay.FormatTimestamp(updated) : "Never")</td>
                            @if (_isAdmin)
                            {
                                <td class="bl-right">
                                    <a class="bl-link" href="@($"/inventory/adjust?bloodType={bloodType}")">Adjust</a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (_lowStock.Count > 0)
    {
        <AlertMessage Variant="danger" Title="Low-stock alert">
            <span>@string.Join(", ", _lowStock.Select(alert => BloodDisplay.BloodTypeLabel(alert.BloodType))) is at or below the minimum threshold.</span>
        </AlertMessage>
    }
}

@code {
    private const int DefaultLowStockThreshold = 10;
    private bool _loading = true;
    private string? _error;
    private bool _isAdmin;
    private IReadOnlyList<InventoryItemDto> _inventory = [];
    private List<LowStockAlertDto> _lowStock = [];

    private static readonly BloodType[] BloodTypes = Enum.GetValues<BloodType>();

    protected override Task OnInitializedAsync() => LoadAsync();

    private InventoryItemDto? FindItem(BloodType bloodType) =>
        _inventory.FirstOrDefault(item => item.BloodType == bloodType);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _isAdmin = CurrentUser.IsInRole(RoleNames.FacilityAdmin);
            _inventory = await InventoryService.GetOwnInventoryAsync();
            _lowStock = (await InventoryService.GetLowStockAlertsAsync(new LowStockQueryRequest())).ToList();
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "no-access";
        }
        catch (Exception)
        {
            _error = "load";
        }
        finally
        {
            _loading = false;
        }
    }
}
