@page "/inventory"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject IInventoryService InventoryService
@inject ICurrentUserService CurrentUser

<PageTitle>Inventory | BloodLink</PageTitle>

<div class="bl-dash-header">
    <div>
        <h1 class="bl-dash-title">Inventory</h1>
        <p class="bl-dash-subtitle">Current blood stock at your facility</p>
    </div>
    @if (_isAdmin)
    {
        <a class="bl-btn bl-btn-primary" href="/inventory/adjust">
            <AppIcon Name="upload" Size="14" /> Adjust Inventory
        </a>
    }
</div>

@if (_loading)
{
    <LoadingState Message="Loading inventory..." />
}
else if (_error == "no-access")
{
    <AlertMessage Variant="danger" Title="No access">
        <span>Your account is not active for operational access.</span>
    </AlertMessage>
}
else if (_error == "load")
{
    <AlertMessage Variant="danger" Title="Couldn't load inventory">
        <span>We couldn't load inventory right now. Please try again later.</span>
    </AlertMessage>
}
else
{
    <section class="bl-card">
        <div class="bl-table-wrap">
            <table class="bl-table">
                <thead>
                    <tr>
                        <th>Blood Type</th>
                        <th>Available</th>
                        <th>Reserved</th>
                        <th>Total</th>
                        <th>Min. Threshold</th>
                        <th>Status</th>
                        @if (_isAdmin) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (value, label) in BloodTypes)
                    {
                        var item = _inventory.FirstOrDefault(inv => inv.BloodType == value);
                        var available = item?.AvailableUnits ?? 0;
                        var low = item is not null && available <= item.LowStockThreshold;
                        <tr>
                            <td><BloodTypeBadge Value="value" /></td>
                            <td class="bl-strong">@available</td>
                            <td class="bl-muted">@(item?.ReservedUnits ?? 0)</td>
                            <td class="bl-muted">@(item?.TotalUnits ?? 0)</td>
                            <td class="bl-muted">@(item?.LowStockThreshold ?? 0)</td>
                            <td>
                                @if (item is null)
                                {
                                    <span class="bl-status-badge bl-status-neutral">Not Set</span>
                                }
                                else if (low)
                                {
                                    <span class="bl-status-badge bl-status-danger">Low Stock</span>
                                }
                                else
                                {
                                    <span class="bl-status-badge bl-status-success">Healthy</span>
                                }
                            </td>
                            @if (_isAdmin)
                            {
                                <td class="bl-right">
                                    <a class="bl-link" href="/inventory/adjust">Adjust <AppIcon Name="chevron-right" Size="12" /></a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (_lowStock.Count > 0)
    {
        <AlertMessage Variant="danger" Title="Low-stock alert">
            <span>@string.Join(", ", _lowStock.Select(alert => BloodDisplay.BloodTypeLabel(alert.BloodType))) is below the minimum threshold.</span>
        </AlertMessage>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private bool _isAdmin;
    private IReadOnlyList<InventoryItemDto> _inventory = [];

    private static readonly (BloodType Value, string Label)[] BloodTypes =
        Enum.GetValues<BloodType>().Select(value => (value, BloodDisplay.BloodTypeLabel(value))).ToArray();

    private List<LowStockAlertDto> _lowStock = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAdmin = CurrentUser.IsInRole(RoleNames.FacilityAdmin);
            _inventory = await InventoryService.GetOwnInventoryAsync();
            _lowStock = (await InventoryService.GetLowStockAlertsAsync(new LowStockQueryRequest())).ToList();
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "no-access";
        }
        catch (Exception)
        {
            _error = "load";
        }
        finally
        {
            _loading = false;
        }
    }
}