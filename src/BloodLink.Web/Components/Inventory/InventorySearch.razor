@page "/inventory/search"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject IInventoryService Inventory
@inject IBloodRequestService Requests
@inject IBloodNeedService Needs
@inject ICurrentUserService CurrentUser

<PageTitle>Network Blood Search | BloodLink</PageTitle>

<div class="bl-breadcrumb">
    <a href="/inventory">Inventory</a>
    <AppIcon Name="chevron-right" Size="12" />
    <span>Network Search</span>
</div>

<div class="bl-dash-header">
    <div>
        <h1 class="bl-dash-title">Network Blood Search</h1>
        <p class="bl-dash-subtitle">Find available blood at other approved facilities</p>
    </div>
</div>

@if (_error == "no-access")
{
    <AlertMessage Variant="danger" Title="No access">
        <span>Only facility administrators can search the network. <a class="bl-inline-link" href="/inventory">View inventory</a>.</span>
    </AlertMessage>
}
else if (_error == "load")
{
    <AlertMessage Variant="danger" Title="Couldn't run the search">
        <span>We couldn't search the network right now. Please try again later.</span>
    </AlertMessage>
}
else if (_error == "invalid")
{
    <AlertMessage Variant="danger" Title="Select a blood type">
        <span>Please choose a blood type before searching.</span>
    </AlertMessage>
}
else
{
    <section class="bl-card bl-card-pad bl-search-card">
        <div class="bl-search-form">
            <div class="bl-field">
                <label class="bl-label" for="search-blood-type">Blood Type</label>
                <InputSelect id="search-blood-type" class="bl-input bl-select" @bind-Value="_bloodType">
                    <option value="">Select blood type</option>
                    @foreach (var type in BloodTypes)
                    {
                        <option value="@type.Value">@type.Label</option>
                    }
                </InputSelect>
            </div>
            <div class="bl-field bl-search-min">
                <label class="bl-label" for="search-min-units">Min. Available Units</label>
                <InputNumber id="search-min-units" class="bl-input" @bind-Value="_minUnits" placeholder="e.g. 4" />
            </div>
            <button class="bl-btn bl-btn-primary bl-search-submit" type="button" @onclick="SearchAsync" disabled="@_busy">
                @if (_busy) { <AppIcon Name="loader" Size="14" Class="bl-spin" /> <span>Searching...</span> }
                else { <AppIcon Name="search" Size="14" /> <span>Search Network</span> }
            </button>
        </div>
    </section>

    @if (_searched && _bloodType is { } selected)
    {
        @if (_results.Count == 0)
        {
            <EmptyState Icon="search" Title="No matches found"
                        Description="@($"No approved facilities currently have {BloodDisplay.BloodTypeLabel(selected)} units available.")" />
        }
        else
        {
            <section class="bl-card">
                <div class="bl-search-results-head">
                    <p>Found <strong>@_results.Count facilities</strong> with available @BloodDisplay.BloodTypeLabel(selected) units</p>
                </div>
                <div class="bl-table-wrap">
                    <table class="bl-table">
                        <thead>
                            <tr>
                                <th>Facility</th>
                                <th>Type</th>
                                <th>City</th>
                                <th>Available Units</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in _results)
                            {
                                <tr>
                                    <td class="bl-strong">@result.FacilityName</td>
                                    <td class="bl-muted">@BloodDisplay.FacilityTypeLabel(result.FacilityType)</td>
                                    <td class="bl-muted">@result.City</td>
                                    <td><span class="bl-avail-lg">@result.AvailableUnits</span> <span class="bl-muted">units</span></td>
                                    <td>
                                        @if (_searchingNeeds.Count > 0)
                                        {
                                            <button class="bl-btn-sm" type="button" @onclick='() => BeginRequest(result)'>
                                                <AppIcon Name="send" Size="12" /> Request Blood
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="bl-muted" title="You need a need in Searching status to send a request">No searching need</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (_searchingNeeds.Count == 0)
                {
                    <p class="bl-search-note">Requests are created from a blood need in <strong>Searching</strong> status. Start a search from your <a class="bl-inline-link" href="/needs">needs</a> first.</p>
                }
            </section>
        }
    }
}

@if (_requestTarget is not null)
{
    <div class="bl-modal-backdrop">
        <div class="bl-modal">
            <h3 class="bl-card-title">Request Blood from @_requestTarget.FacilityName</h3>
            <p class="bl-card-desc">Send a request for @UnitsLabel from this facility using one of your searching needs.</p>

            <label class="bl-label" for="req-need">Blood need to fulfil <span>*</span></label>
            <InputSelect id="req-need" class="bl-input bl-select" @bind-Value="_selectedNeedId">
                <option value="">Select a searching need</option>
                @foreach (var need in _searchingNeeds)
                {
                    <option value="@need.Id">
                        @BloodDisplay.BloodTypeLabel(need.BloodType) · @need.UnitsNeeded units (@BloodDisplay.ShortId(need.Id))
                    </option>
                }
            </InputSelect>

            <label class="bl-label" for="req-units">Units requested <span>*</span></label>
            <InputNumber id="req-units" class="bl-input" @bind-Value="_requestUnits" min="1"
                         max="@(SelectedNeed?.UnitsNeeded ?? 1)" placeholder="e.g. 4" />
            @if (SelectedNeed is not null)
            {
                <p class="bl-field-hint">At most @SelectedNeed.UnitsNeeded units for this need.</p>
            }

            <label class="bl-label" for="req-note">Request note (optional)</label>
            <InputTextArea id="req-note" class="bl-input" @bind-Value="_requestNote" rows="2"
                           placeholder="e.g. urgent surgical case" />

            @if (_requestBusy)
            {
                <LoadingState Message="Sending request..." />
            }
            @if (!string.IsNullOrEmpty(_requestError))
            {
                <AlertMessage Variant="danger" Title="Couldn't send request">
                    <span>@_requestError</span>
                </AlertMessage>
            }
            @if (_requestSent)
            {
                <AlertMessage Variant="success" Title="Request sent">
                    <span>Your facility admin will be notified of the response.</span>
                </AlertMessage>
            }

            <div class="bl-confirm-actions">
                <button class="bl-btn bl-btn-outline" type="button" @onclick="CancelRequest">Cancel</button>
                <button class="bl-btn bl-btn-primary" type="button" @onclick="SendRequestAsync"
                        disabled='@(_requestBusy || !_requestSent && (_selectedNeedId is null || _requestUnits <= 0))'>
                    @if (_requestSent) { <AppIcon Name="check" Size="14" /> <span>Done</span> }
                    else { <AppIcon Name="send" Size="14" /> <span>Send Request</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private BloodType? _bloodType;
    private int? _minUnits;
    private bool _busy;
    private bool _searched;
    private string? _error;
    private IReadOnlyList<AvailabilityResultDto> _results = [];
    private IReadOnlyList<BloodNeedDto> _searchingNeeds = [];

    private AvailabilityResultDto? _requestTarget;
    private Guid? _selectedNeedId;
    private int _requestUnits = 1;
    private string? _requestNote;
    private bool _requestBusy;
    private string? _requestError;
    private bool _requestSent;

    private BloodNeedDto? SelectedNeed => _searchingNeeds.FirstOrDefault(need => need.Id == _selectedNeedId);

    private string UnitsLabel => _bloodType is { } type
        ? BloodDisplay.BloodTypeLabel(type)
        : "blood";

    private static readonly (BloodType Value, string Label)[] BloodTypes =
        Enum.GetValues<BloodType>().Select(value => (value, BloodDisplay.BloodTypeLabel(value))).ToArray();

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsInRole(RoleNames.FacilityAdmin))
        {
            _error = "no-access";
            return;
        }

        try
        {
            _searchingNeeds = (await Needs.ListOwnFacilityAsync()).Where(need => need.Status == BloodNeedStatus.Searching).ToList();
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "no-access";
        }
        catch (Exception)
        {
            _searchingNeeds = [];
        }
    }

    private async Task SearchAsync()
    {
        if (_bloodType is not { } selected)
        {
            _error = "invalid";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _results = await Inventory.SearchAvailabilityAsync(
                new AvailabilitySearchRequest(selected, Math.Max(_minUnits ?? 0, 1)));
            _searched = true;
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "no-access";
        }
        catch (Exception)
        {
            _error = "load";
        }
        finally
        {
            _busy = false;
        }
    }

    private void BeginRequest(AvailabilityResultDto result)
    {
        _requestTarget = result;
        _selectedNeedId = _searchingNeeds.FirstOrDefault(need => need.BloodType == result.BloodType)?.Id;
        var match = _searchingNeeds.FirstOrDefault(need => need.Id == _selectedNeedId);
        _requestUnits = match?.UnitsNeeded ?? 1;
        _requestNote = null;
        _requestError = null;
        _requestSent = false;
    }

    private void CancelRequest()
    {
        _requestTarget = null;
        _selectedNeedId = null;
        _requestNote = null;
        _requestError = null;
        _requestSent = false;
    }

    private async Task SendRequestAsync()
    {
        if (_requestTarget is null || _selectedNeedId is not { } needId)
        {
            return;
        }

        _requestBusy = true;
        _requestError = null;
        try
        {
            await Requests.CreateFromNeedAsync(new CreateBloodRequestRequest(
                needId,
                _requestTarget.FacilityId,
                Math.Max(_requestUnits, 1),
                _requestNote));
            _requestSent = true;
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _requestError = "You are not authorized to create requests.";
        }
        catch (Exception ex)
        {
            _requestError = ex.Message;
        }
        finally
        {
            _requestBusy = false;
        }
    }
}