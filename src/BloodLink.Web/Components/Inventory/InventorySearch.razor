@page "/inventory/search"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.RequireFacilityAdmin)]
@inject IInventoryService Inventory
@inject ICurrentUserService CurrentUser

<PageTitle>Network Blood Search | BloodLink</PageTitle>

<div class="bl-breadcrumb">
    <a href="/inventory">Inventory</a>
    <AppIcon Name="chevron-right" Size="12" />
    <span>Network Search</span>
</div>

<div class="bl-dash-header">
    <div>
        <h1 class="bl-dash-title">Network Blood Search</h1>
        <p class="bl-dash-subtitle">Find exact blood-type availability at other approved facilities</p>
    </div>
</div>

@if (_error == "no-access")
{
    <AlertMessage Variant="danger" Title="No access">
        <span>Only active facility administrators can search the network. <a class="bl-inline-link" href="/inventory">View inventory</a>.</span>
    </AlertMessage>
}
else
{
    <section class="bl-card bl-card-pad bl-search-card">
        <div class="bl-search-form">
            <div class="bl-field">
                <label class="bl-label" for="search-blood-type">Blood Type <span>*</span></label>
                <InputSelect id="search-blood-type" class="bl-input bl-select" @bind-Value="_bloodType">
                    <option value="">Select blood type</option>
                    @foreach (var type in BloodTypes)
                    {
                        <option value="@type">@BloodDisplay.BloodTypeLabel(type)</option>
                    }
                </InputSelect>
            </div>
            <div class="bl-field bl-search-min">
                <label class="bl-label" for="search-min-units">Minimum Available Units</label>
                <InputNumber id="search-min-units" class="bl-input" @bind-Value="_minUnits" min="1" placeholder="e.g. 4" />
            </div>
            <button class="bl-btn bl-btn-primary bl-search-submit" type="button" @onclick="SearchAsync" disabled="@_busy">
                @if (_busy) { <AppIcon Name="loader" Size="14" Class="bl-spin" /> <span>Searching...</span> }
                else { <AppIcon Name="search" Size="14" /> <span>Search Network</span> }
            </button>
        </div>
        @if (_message is { Length: > 0 })
        {
            <AlertMessage Variant="@_messageVariant" Title="@_messageTitle">
                <span>@_message</span>
            </AlertMessage>
        }
    </section>

    @if (_searched && _bloodType is { } selected)
    {
        @if (_results.Count == 0)
        {
            <EmptyState Icon="search" Title="No eligible facilities found"
                        Description="@($"No approved external facility currently has available {BloodDisplay.BloodTypeLabel(selected)} units matching this exact-type search.")" />
        }
        else
        {
            <section class="bl-card" aria-labelledby="search-results-title">
                <div class="bl-card-head">
                    <h2 id="search-results-title">Exact-Type Results</h2>
                    <span class="bl-muted">@_results.Count eligible facilities</span>
                </div>
                <div class="bl-table-wrap">
                    <table class="bl-table">
                        <thead>
                            <tr>
                                <th>Facility</th>
                                <th>Type</th>
                                <th>Location</th>
                                <th>Blood Type</th>
                                <th>Available Units</th>
                                <th>Last Updated</th>
                                <th>Next Step</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in _results)
                            {
                                <tr>
                                    <td class="bl-strong">@result.FacilityName</td>
                                    <td class="bl-muted">@BloodDisplay.FacilityTypeLabel(result.FacilityType)</td>
                                    <td class="bl-muted">@Location(result)</td>
                                    <td><BloodTypeBadge Value="@result.BloodType" /></td>
                                    <td><span class="bl-avail-lg">@result.AvailableUnits</span> <span class="bl-muted">available</span></td>
                                    <td class="bl-muted">@BloodDisplay.FormatTimestamp(result.UpdatedAtUtc)</td>
                                    <td><span class="bl-muted">Request workflow is Phase 5C</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="bl-search-note">Search is exact blood type only. Reserved stock is excluded from available units. Creating external requests is not part of Phase 5B.</p>
            </section>
        }
    }
}

@code {
    private BloodType? _bloodType;
    private int? _minUnits;
    private bool _busy;
    private bool _searched;
    private string? _error;
    private string? _message;
    private string _messageTitle = "Check the search";
    private string _messageVariant = "danger";
    private IReadOnlyList<AvailabilityResultDto> _results = [];

    private static readonly BloodType[] BloodTypes = Enum.GetValues<BloodType>();

    protected override void OnInitialized()
    {
        if (!CurrentUser.IsInRole(RoleNames.FacilityAdmin))
        {
            _error = "no-access";
        }
    }

    private async Task SearchAsync()
    {
        _message = null;
        if (_bloodType is not { } selected)
        {
            SetMessage("Please choose one canonical blood type before searching.", "danger", "Blood type required");
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _results = await Inventory.SearchAvailabilityAsync(
                new AvailabilitySearchRequest(selected, Math.Max(_minUnits ?? 1, 1)));
            _searched = true;
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "no-access";
        }
        catch (Exception)
        {
            SetMessage("We couldn't search the network right now. Please try again later.", "danger", "Search failed");
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetMessage(string message, string variant, string title)
    {
        _message = message;
        _messageVariant = variant;
        _messageTitle = title;
    }

    private static string Location(AvailabilityResultDto result) =>
        string.IsNullOrWhiteSpace(result.Region)
            ? result.City
            : $"{result.City}, {result.Region}";
}
