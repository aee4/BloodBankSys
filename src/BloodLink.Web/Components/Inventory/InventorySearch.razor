@page "/inventory/search"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.RequireFacilityAdmin)]
@inject IInventoryService Inventory
@inject IBloodNeedService Needs
@inject IBloodRequestService Requests
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Network Blood Search | BloodLink</PageTitle>

<div class="bl-breadcrumb">
    <a href="/inventory">Inventory</a>
    <AppIcon Name="chevron-right" Size="12" />
    <span>Network Search</span>
</div>

<div class="bl-dash-header">
    <div>
        <h1 class="bl-dash-title">Network Blood Search</h1>
        <p class="bl-dash-subtitle">Find exact blood-type availability at other approved facilities</p>
    </div>
</div>

@if (_needLoadError)
{
    <AlertMessage Variant="danger" Title="Need unavailable"><span>This need could not be loaded or is not eligible for network search.</span></AlertMessage>
}
else if (_need is not null)
{
    <section class="bl-card bl-card-pad">
        <h2 class="bl-card-title">External request for Need @BloodDisplay.ShortId(_need.Id)</h2>
        <p>Blood type: <BloodTypeBadge Value="_need.BloodType" /> <strong>@_need.UnitsNeeded units</strong> required. Source availability is checked again when you submit.</p>
        <p class="bl-muted">Request creation does not reserve inventory.</p>
        <div class="bl-field">
            <label class="bl-label" for="source-facility">Source facility <span>*</span></label>
            <InputSelect id="source-facility" class="bl-input bl-select" @bind-Value="_selectedSourceId">
                <option value="">Select a search result</option>
                @foreach (var result in _results)
                {
                    <option value="@result.FacilityId">@result.FacilityName - @result.AvailableUnits available</option>
                }
            </InputSelect>
        </div>
        <div class="bl-field">
            <label class="bl-label" for="request-note">Request note (optional)</label>
            <InputTextArea id="request-note" class="bl-input bl-textarea" @bind-Value="_requestNote" rows="2" maxlength="1000" />
        </div>
        @if (_confirmRequest)
        {
            <div class="bl-confirm-box" role="alertdialog" aria-labelledby="request-confirm-title">
                <h3 id="request-confirm-title">Confirm external request</h3>
                <p>The selected approved facility will receive a request for @_need.UnitsNeeded units of @BloodDisplay.BloodTypeLabel(_need.BloodType). No stock is reserved until the source accepts.</p>
                @if (_createError is not null)
                {
                    <AlertMessage Variant="danger" Title="Request not created"><span>@_createError</span></AlertMessage>
                }
                <div class="bl-confirm-actions">
                    <button class="bl-btn bl-btn-outline" type="button" @onclick="() => _confirmRequest = false" disabled="@_creating">Back</button>
                    <button class="bl-btn bl-btn-primary" type="button" @onclick="CreateRequestAsync" disabled="@(_creating || _selectedSourceId is null)">
                        @(_creating ? "Submitting..." : "Send request")
                    </button>
                </div>
            </div>
        }
        else
        {
            <button class="bl-btn bl-btn-primary" type="button" @onclick="() => _confirmRequest = true" disabled="@(_selectedSourceId is null || _creating)">Review request</button>
        }
    </section>
}

@if (_error == "no-access")
{
    <AlertMessage Variant="danger" Title="No access">
        <span>Only active facility administrators can search the network. <a class="bl-inline-link" href="/inventory">View inventory</a>.</span>
    </AlertMessage>
}
else
{
    <section class="bl-card bl-card-pad bl-search-card">
        <div class="bl-search-form">
            <div class="bl-field">
                <label class="bl-label" for="search-blood-type">Blood Type <span>*</span></label>
                <InputSelect id="search-blood-type" class="bl-input bl-select" @bind-Value="_bloodType">
                    <option value="">Select blood type</option>
                    @foreach (var type in BloodTypes)
                    {
                        <option value="@type">@BloodDisplay.BloodTypeLabel(type)</option>
                    }
                </InputSelect>
            </div>
            <div class="bl-field bl-search-min">
                <label class="bl-label" for="search-min-units">Minimum Available Units</label>
                <InputNumber id="search-min-units" class="bl-input" @bind-Value="_minUnits" min="1" placeholder="e.g. 4" />
            </div>
            <button class="bl-btn bl-btn-primary bl-search-submit" type="button" @onclick="SearchAsync" disabled="@_busy">
                @if (_busy) { <AppIcon Name="loader" Size="14" Class="bl-spin" /> <span>Searching...</span> }
                else { <AppIcon Name="search" Size="14" /> <span>Search Network</span> }
            </button>
        </div>
        @if (_message is { Length: > 0 })
        {
            <AlertMessage Variant="@_messageVariant" Title="@_messageTitle">
                <span>@_message</span>
            </AlertMessage>
        }
    </section>

    @if (_searched && _bloodType is { } selected)
    {
        @if (_results.Count == 0)
        {
            <EmptyState Icon="search" Title="No eligible facilities found"
                        Description="@($"No approved external facility currently has available {BloodDisplay.BloodTypeLabel(selected)} units matching this exact-type search.")" />
        }
        else
        {
            <section class="bl-card" aria-labelledby="search-results-title">
                <div class="bl-card-head">
                    <h2 id="search-results-title">Exact-Type Results</h2>
                    <span class="bl-muted">@_results.Count eligible facilities</span>
                </div>
                <div class="bl-table-wrap">
                    <table class="bl-table">
                        <thead>
                            <tr>
                                <th>Facility</th>
                                <th>Type</th>
                                <th>Location</th>
                                <th>Blood Type</th>
                                <th>Available Units</th>
                                <th>Last Updated</th>
                                <th>Next Step</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in _results)
                            {
                                <tr>
                                    <td class="bl-strong">@result.FacilityName</td>
                                    <td class="bl-muted">@BloodDisplay.FacilityTypeLabel(result.FacilityType)</td>
                                    <td class="bl-muted">@Location(result)</td>
                                    <td><BloodTypeBadge Value="@result.BloodType" /></td>
                                    <td><span class="bl-avail-lg">@result.AvailableUnits</span> <span class="bl-muted">available</span></td>
                                    <td class="bl-muted">@BloodDisplay.FormatTimestamp(result.UpdatedAtUtc)</td>
                                    <td>
                                        @if (_need is not null)
                                        {
                                            <button class="bl-btn-sm bl-btn-sm-success" type="button" @onclick="() => SelectSource(result.FacilityId)">Select source</button>
                                        }
                                        else
                                        {
                                            <span class="bl-muted">Search from an eligible need to request</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="bl-search-note">Search matches exact blood type. Reserved stock is excluded. Availability is rechecked when a request is submitted.</p>
            </section>
        }
    }
}

@code {
    private BloodType? _bloodType;
    private int? _minUnits;
    private bool _busy;
    private bool _searched;
    private string? _error;
    private string? _message;
    private string _messageTitle = "Check the search";
    private string _messageVariant = "danger";
    private IReadOnlyList<AvailabilityResultDto> _results = [];
    private bool _needLoadError;
    private bool _confirmRequest;
    private bool _creating;
    private string? _createError;
    private string? _requestNote;
    private Guid? _selectedSourceId;
    private BloodNeedDetailDto? _need;

    [SupplyParameterFromQuery(Name = "needId")]
    public Guid? NeedId { get; set; }

    private static readonly BloodType[] BloodTypes = Enum.GetValues<BloodType>();

    protected override async Task OnParametersSetAsync()
    {
        if (!CurrentUser.IsInRole(RoleNames.FacilityAdmin))
        {
            _error = "no-access";
            return;
        }

        if (NeedId is { } needId)
        {
            try
            {
                _need = await Needs.GetAsync(needId);
                if (_need is null || _need.Status != BloodNeedStatus.Searching)
                {
                    _need = null;
                    _needLoadError = true;
                    return;
                }

                _bloodType = _need.BloodType;
                _minUnits = _need.UnitsNeeded;
                await SearchAsync();
            }
            catch (Exception)
            {
                _needLoadError = true;
            }
        }
    }

    private async Task SearchAsync()
    {
        _message = null;
        if (_bloodType is not { } selected)
        {
            SetMessage("Please choose one canonical blood type before searching.", "danger", "Blood type required");
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _results = await Inventory.SearchAvailabilityAsync(
                new AvailabilitySearchRequest(selected, Math.Max(_minUnits ?? 1, 1)));
            _searched = true;
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "no-access";
        }
        catch (Exception)
        {
            SetMessage("We couldn't search the network right now. Please try again later.", "danger", "Search failed");
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetMessage(string message, string variant, string title)
    {
        _message = message;
        _messageVariant = variant;
        _messageTitle = title;
    }

    private void SelectSource(Guid facilityId)
    {
        if (_results.Any(result => result.FacilityId == facilityId))
        {
            _selectedSourceId = facilityId;
            _createError = null;
            _confirmRequest = true;
        }
    }

    private async Task CreateRequestAsync()
    {
        if (_need is null || _selectedSourceId is not { } sourceId || _creating)
        {
            return;
        }

        _creating = true;
        _createError = null;
        try
        {
            var request = await Requests.CreateFromNeedAsync(new CreateBloodRequestRequest(
                _need.Id, sourceId, _need.UnitsNeeded, string.IsNullOrWhiteSpace(_requestNote) ? null : _requestNote.Trim()));
            Navigation.NavigateTo($"/requests/{request.Id}");
        }
        catch (BloodLink.Domain.Exceptions.InsufficientInventoryException)
        {
            _createError = "Availability changed. No request was created; search again for current stock.";
            _searched = false;
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _createError = "Your account is not authorized to create this request.";
        }
        catch (Exception)
        {
            _createError = "The request could not be confirmed as created. Refresh the need and try again.";
        }
        finally
        {
            _creating = false;
        }
    }

    private static string Location(AvailabilityResultDto result) =>
        string.IsNullOrWhiteSpace(result.Region)
            ? result.City
            : $"{result.City}, {result.Region}";
}
