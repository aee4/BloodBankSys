@page "/requests/sent"
@layout DashboardLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.RequireFacilityAdmin)]
@inject IBloodRequestService Requests
@inject ICurrentUserService CurrentUser

<PageTitle>Requests Sent | BloodLink</PageTitle>

<div class="bl-dash-header">
    <div>
        <h1 class="bl-dash-title">Requests Sent</h1>
        <p class="bl-dash-subtitle">Blood requests sent to other facilities</p>
    </div>
</div>

@if (_loading)
{
    <LoadingState Message="Loading sent requests..." />
}
else if (_error == "no-access")
{
    <AlertMessage Variant="danger" Title="No access">
        <span>Only facility administrators can manage blood requests.</span>
    </AlertMessage>
}
else if (_error == "load")
{
    <AlertMessage Variant="danger" Title="Couldn't load requests">
        <span>We couldn't load your sent requests right now. Please try again later.</span>
    </AlertMessage>
}
else
{
    <div class="bl-field bl-filter-control">
        <label class="bl-label" for="sent-status-filter">Status</label>
        <InputSelect id="sent-status-filter" class="bl-input bl-select" @bind-Value="_statusFilter">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<BloodRequestStatus>()) { <option value="@status">@BloodDisplay.BloodRequestStatusLabel(status)</option> }
        </InputSelect>
    </div>
    @if (!Filtered.Any())
    {
        <EmptyState Icon="send" Title="@(_requests.Count == 0 ? "No requests sent yet" : "No matching requests")"
                    Description="@(_requests.Count == 0 ? "Requests sent to other facilities will appear here." : "Change the status filter to see other requests.")">
            @if (_requests.Count == 0) { <a class="bl-btn bl-btn-primary" href="/needs">Review needs</a> }
        </EmptyState>
    }
    else
    {
    <section class="bl-card">
        <div class="bl-table-wrap">
            <table class="bl-table">
                <thead>
                    <tr>
                        <th>Request</th>
                        <th>Source facility</th>
                        <th>Need</th>
                        <th>Blood Type</th>
                        <th>Requested / accepted</th>
                        <th>Urgency</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Created / responded / completed</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Filtered)
                    {
                        <tr>
                            <td class="bl-mono">@BloodDisplay.ShortId(request.Id)</td>
                            <td class="bl-strong">@request.SourceFacilityName</td>
                            <td><a class="bl-inline-link" href="@($"/needs/{request.BloodNeedId}")">Need @BloodDisplay.ShortId(request.BloodNeedId)</a></td>
                            <td><BloodTypeBadge Value="request.BloodType" /></td>
                            <td class="bl-strong">@request.UnitsRequested / @(request.UnitsAccepted?.ToString() ?? "-")</td>
                            <td>@BloodDisplay.UrgencyLabel(request.Priority)</td>
                            <td>
                                <span class="bl-status-badge bl-status-@BloodDisplay.BloodRequestStatusTone(request.Status)">
                                    @BloodDisplay.BloodRequestStatusLabel(request.Status)
                                </span>
                            </td>
                            <td>@request.RequestNote @if (!string.IsNullOrWhiteSpace(request.ResponseNote)) { <span> / @request.ResponseNote</span> }</td>
                            <td class="bl-muted">@BloodDisplay.FormatTimestamp(request.CreatedAtUtc)<br />@DateLine(request.RespondedAtUtc, request.FulfilledAtUtc)</td>
                            <td><a class="bl-link" href="@($"/requests/{request.Id}")">Details <AppIcon Name="chevron-right" Size="12" /></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<BloodRequestDto> _requests = [];
    private string _statusFilter = string.Empty;
    private IEnumerable<BloodRequestDto> Filtered => _requests
        .Where(request => string.IsNullOrEmpty(_statusFilter) || request.Status.ToString() == _statusFilter)
        .OrderByDescending(request => request.CreatedAtUtc).ThenBy(request => request.Id);

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsInRole(RoleNames.FacilityAdmin))
        {
            _loading = false;
            _error = "no-access";
            return;
        }

        try
        {
            _requests = await Requests.ListSentAsync();
        }
        catch (BloodLink.Domain.Exceptions.UnauthorizedAccessException)
        {
            _error = "no-access";
        }
        catch (Exception)
        {
            _error = "load";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string DateLine(DateTime? responded, DateTime? fulfilled) =>
        $"Responded: {(responded is null ? "-" : BloodDisplay.FormatTimestamp(responded.Value))} | Completed: {(fulfilled is null ? "-" : BloodDisplay.FormatTimestamp(fulfilled.Value))}";
}
